[user]
    name = {{ .name }}
    email = {{ .email }}

[init]
    defaultBranch = main

[core]
{{- if eq .chezmoi.os "windows" }}
    autocrlf = true
{{- else }}
    autocrlf = input
{{- end }}
    pager = delta

[credential]
{{- if .isWsl }}
{{-   $gcm := glob "/mnt/c/Program Files/Git/*/bin/git-credential-manager.exe" }}
{{-   if $gcm }}
    # Reuse Git Credential Manager from Git for Windows, so you sign in once for both sides.
    # Newer Git for Windows ships it under ucrt64/, older versions under mingw64/.
    helper = {{ first $gcm | replace " " "\\\\ " }}
{{-   end }}
{{- else if eq .chezmoi.os "windows" }}
    helper = manager
{{- end }}

[interactive]
    diffFilter = delta --color-only

[include]
    # Catppuccin delta styles, downloaded by .chezmoiexternal.toml.tmpl
    path = ~/.config/delta/catppuccin.gitconfig

[delta]
    features = catppuccin-mocha
    # Windows Terminal doesn't set COLORTERM, so delta would fall back to 256 colors
    true-color = always
    navigate = true
    line-numbers = true

[merge]
    conflictStyle = zdiff3

[diff]
    colorMoved = default

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[rerere]
    enabled = true
