# Registers the per-user font files that .chezmoiexternal.toml.tmpl downloads (no admin needed).
# Re-runs whenever the font source changes: {{ include ".chezmoiexternal.toml.tmpl" | sha256sum }}
$dir = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts\JetBrainsMonoNerdFont'
$key = 'HKCU:\Software\Microsoft\Windows NT\CurrentVersion\Fonts'
if (-not (Test-Path $dir)) { return }
if (-not (Test-Path $key)) { New-Item $key -Force | Out-Null }

Add-Type -Namespace Win32 -Name Fonts -MemberDefinition @'
[DllImport("gdi32.dll", CharSet = CharSet.Unicode)]
public static extern int AddFontResource(string file);
[DllImport("user32.dll")]
public static extern IntPtr SendMessageTimeout(IntPtr hWnd, uint msg, IntPtr wParam, IntPtr lParam, uint flags, uint timeout, out IntPtr result);
'@

# Drop registrations for files from an older version that no longer exist
$registered = Get-ItemProperty $key
foreach ($name in (Get-Item $key).Property) {
    $path = $registered.$name
    if ($path -like "$dir\*" -and -not (Test-Path $path)) { Remove-ItemProperty $key -Name $name }
}

foreach ($font in Get-ChildItem $dir -Filter *.ttf) {
    New-ItemProperty $key -Name "$($font.BaseName) (TrueType)" -Value $font.FullName -PropertyType String -Force | Out-Null
    [Win32.Fonts]::AddFontResource($font.FullName) | Out-Null
}

# Tell running apps the font list changed (WM_FONTCHANGE to all top-level windows)
$result = [IntPtr]::Zero
[Win32.Fonts]::SendMessageTimeout([IntPtr]0xffff, 0x1D, [IntPtr]::Zero, [IntPtr]::Zero, 2, 1000, [ref]$result) | Out-Null
Write-Host "Registered JetBrainsMono Nerd Font for $env:USERNAME"
